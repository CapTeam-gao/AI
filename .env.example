LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capteam-ai

OPENAI_API_KEY=
UPSTAGE_API_KEY=
UPSTAGE_API_BASE=https://api.upstage.ai/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gao_db
DB_USER=gao_user
DB_PASSWORD=change-me

# Docker deployment uses the shared backend_internal network.
BACKEND_BASE_URL=http://gao-backend:8080

# Backend/.env의 INTERNAL_MATCHING_API_KEY와 반드시 같은 값을 사용하세요.
INTERNAL_MATCHING_API_KEY=replace-with-the-same-random-key-as-backend

AI_BIND_ADDRESS=127.0.0.1
AI_PORT=8000
